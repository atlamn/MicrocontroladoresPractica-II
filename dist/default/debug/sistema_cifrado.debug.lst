   649     01C3                     clear_ram0:	
   650                           ;	Called with FSR containing the base address, and
   651                           ;	W with the last address+1
   652                           
   653     01C3  0064               	clrwdt	;clear the watchdog before getting into this loop
   654     01C4                     clrloop0:
   655     01C4  0180               	clrf	0	;clear RAM location pointed to by FSR
   656     01C5  0A84               	incf	4,f	;increment pointer
   657     01C6  0604               	xorwf	4,w	;XOR with final address
   658     01C7  1903               	btfsc	3,2	;have we reached the end yet?
   659     01C8  3400               	retlw	0	;all done for this memory range, return
   660     01C9  0604               	xorwf	4,w	;XOR again to restore value
   661     01CA  29C4               	goto	clrloop0	;do the next byte
